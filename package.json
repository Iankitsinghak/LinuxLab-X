{
  "name": "linuxlabx",
  "displayName": "LinuxLabX",
  "description": "LinuxLabX terminal simulator inside VS Code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.116.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "linuxlabx.start",
        "title": "Start LinuxLabX"
      },
      {
        "command": "linuxlabx.resetSession",
        "title": "LinuxLabX: Reset Session"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "linuxlabx",
          "title": "LinuxLabX",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "linuxlabx": [
        {
          "id": "linuxlabxView",
          "name": "Terminal",
          "type": "webview",
          "icon": "media/icon.svg"
        }
      ]
    },
    "configuration": {
      "title": "LinuxLabX",
      "properties": {
        "linuxlabx.autoRestoreSession": {
          "type": "boolean",
          "default": true,
          "description": "Restore LinuxLabX virtual filesystem and tutorial state between sessions."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.116.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
